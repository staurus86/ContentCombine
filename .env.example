# ContentCombine — пример конфигурации.
# Скопируй в .env и заполни значения. Файл .env в git не попадает (см. .gitignore).

# ── Обязательное ───────────────────────────────────────────────
# Postgres в проде, можно SQLite-файл локально (например sqlite:///local.db)
DATABASE_URL=

# LLM-доступ (OpenAI-совместимый эндпоинт: OpenAI, LiteLLM-гейтвей и т.п.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODELS=
LLM_DAILY_CAP_USD=5
LLM_TEMPERATURE=0.7

# Веб-админка
ADMIN_PASSWORD=
COOKIE_SECRET=
PORT=8080

# ── Опциональные интеграции (можно оставить пустыми) ───────────
# Keyso — частотность/ключевые слова
KEYSO_API_KEY=
KEYSO_REGION=

# Google Sheets — выгрузка готовых постов
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_TAB_READY=
SHEETS_TAB_NOT_READY=

# Публикация в Telegram (пусто => пост копируется в буфер из UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLISH_CHANNEL=
TELEGRAM_ALERT_CHAT=
TELEGRAM_CHAT_IDS=

# Чтение Telegram-каналов как источников (Telethon)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Публикация во ВКонтакте
VK_API_TOKEN=

# ── Тюнинг (есть разумные дефолты в config.py) ─────────────────
# PROXY_LIST=
# USER_AGENT_ROTATE=
# SCORE_WEIGHT_INTERNAL=
# SCORE_WEIGHT_VIRAL=
# SCORE_WEIGHT_KEYSO=
# SCORE_WEIGHT_TRENDS=
# SCORE_WEIGHT_HEADLINE=
# AUTO_REWRITE_ON_PUBLISH_NOW=
# AUTO_REWRITE_STYLE=
